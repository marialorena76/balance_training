"","nofollow":"","custom_attributes":""},"_css_classes":"bta-btn bta-btn-light"},"elements":[]}]},{"id":"100d889","elType":"widget","widgetType":"text-editor","settings":{"editor":"<dl class='bta-facts'><div><dt>3 etapas</dt><dd>online · presencial · mentoring</dd></div><div><dt>18 años</dt><dd>formando profesionales</dd></div></dl>","_css_classes":""},"elements":[]}]},{"id":"1013556","elType":"container","isInner":true,"settings":{"flex_direction":"column","content_width":"full","width":{"unit":"%","size":46,"sizes":[]},"width_mobile":{"unit":"%","size":100,"sizes":[]},"css_classes":"","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"flex_gap":{"column":"18","row":"18","unit":"px","isLinked":true}},"elements":[{"id":"100f778","elType":"widget","widgetType":"image","settings":{"image":{"url":"https://soyloregonzalez.com.ar/balancetraining/wp-content/uploads/2026/10/bta-portada-formacion-integral.jpg","id":464,"alt":"Portada: Formación Ecuestre Integral 2027","source":"library"},"image_size":"large","_css_classes":"bta-hero-img"},"elements":[]}]}]}]}]},{"id":"1020ddf","elType":"container","isInner":false,"settings":{"flex_direction":"column","content_width":"full","css_classes":"bta-section","background_background":"classic","background_color":"#FFFFFF","padding":{"unit":"px","top":"88","right":"24","bottom":"88","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"60","right":"18","bottom":"60","left":"18","isLinked":false}},"elements":[{"id":"101eef0","elType":"container","isInner":true,"settings":{"flex_direction":"column","content_width":"boxed","boxed_width":{"unit":"px","size":780,"sizes":[]},"flex_gap":{"column":"24","row":"24","unit":"px","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"101b112","elType":"widget","widgetType":"heading","settings":{"title":"¿De qué se trata?","header_size":"h2","_css_classes":"bta-h"},"elements":[]},{"id":"101d001","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class='bta-lead'>Es la única Formación Integral para las personas del área ecuestre que deseen profesionalizarse con bases sólidas.</p><p>La Formación abarca desde la construcción y preparación psico-física del jinete entrenador, paso a paso, hasta la formación de caballos deportivos desde sus inicios. Con clases teóricas, teórico-prácticas y prácticas, donde los alumnos tienen la posibilidad de trabajar con caballos en diferentes etapas de doma, entrenamiento o reeducación en Relinchos.</p><p>El programa está diseñado para proporcionar una experiencia educativa completa en el mundo ecuestre, combinando teoría, acompañamiento personalizado y práctica, en tres secciones complementarias que garantizan un aprendizaje efectivo y profundo.</p><p>Comprende 4 módulos en los que vamos trabajando sobre diferentes temas y explorando nuevas visiones. Aplicamos nuestro Método Balance Training® y la Equitación Centrada, adaptados a la necesidad de cada jinete y cada caballo, con un trabajo personalizado.</p>","_css_classes":"bta-prose"},"elements":[]}]}]},{"id":"102a88a","elType":"container","isInner":false,"settings":{"flex_direction":"column","content_width":"full","css_classes":"bta-section","background_background":"classic","background_color":"#F6EFE2","padding":{"unit":"px","top":"88","right":"24","bottom":"88","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"60","right":"18","bottom":"60","left":"18","isLinked":false}},"elements":[{"id":"102899b","elType":"container","isInner":true,"settings":{"flex_direction":"column","content_width":"boxed","boxed_width":{"unit":"px","size":860,"sizes":[]},"flex_gap":{"column":"10","row":"10","unit":"px","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"1022cce","elType":"widget","widgetType":"heading","settings":{"title":"Las 3 etapas de la Formación","header_size":"h2","_css_classes":"bta-h"},"elements":[]},{"id":"1024bbd","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class='bta-muted'>3 etapas</p>","_css_classes":""},"elements":[]},{"id":"1026aac","elType":"widget","widgetType":"text-editor","settings":{"editor":"<ol class='bta-prog'><li><span class='bta-num'>01</span><div><strong>Etapa 1: Online</strong><p>Volcamos todos los contenidos teóricos y teórico-prácticos y su fundamentación. 4 módulos dictados en 8 Master Classes por Zoom.</p></div></li><li><span class='bta-num'>02</span><div><strong>Etapa 2: Presencial</strong><p>Ponemos en práctica todos los contenidos trabajando con caballos en diferentes estadios de entrenamiento, siguiendo el orden de los 4 módulos. Tres días completos. Fecha y lugar a confirmar.</p></div></li><li><span class='bta-num'>03</span><div><strong>Etapa 3: Mentoring</strong><p>2 sesiones individuales de 1 hora para procesar todo lo aprendido, dar forma a un trabajo final y acompañarte en la puesta en acción de los logros que quieras alcanzar a nivel profesional o personal. Entrega del trabajo final y reunión online de cierre con entrega de certificados a quienes completen las tres etapas.</p></div></li></ol>","_css_classes":""},"elements":[]}]}]},{"id":"1034335","elType":"container","isInner":false,"settings":{"flex_direction":"column","content_width":"full","css_classes":"bta-section","background_background":"classic","background_color":"#FFFFFF","padding":{"unit":"px","top":"88","right":"24","bottom":"88","left":"24","isLinked":false},"padding_mobile":{"unit":"px","top":"60","right":"18","bottom":"60","left":"18","isLinked":false}},"elements":[{"id":"1032446","elType":"container","isInner":true,"settings":{"flex_direction":"column","content_width":"boxed","boxed_width":{"unit":"px","size":1000,"sizes":[]},"flex_gap":{"column":"24","row":"24","unit":"px","isLinked":true},"padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false}},"elements":[{"id":"102c779","elType":"widget","widgetType":"heading","settings":{"title":"¿Qué vas a obtener?","header_size":"h2","_css_classes":"bta-h"},"elements":[]},{"id":"102e668","elType":"widget","widgetType":"text-editor","settings":{"editor":"<ul class='bta-checks bta-checks-2'><li>Una comprensión integral del caballo, contemplando sus aspectos físicos, mentales y emocionales.</li><li>Bases técnicas ecuestres sólidas, aplicables a diferentes disciplinas.</li><li>Una comprensión más profunda de la biomecánica y la preparación psicofísica del jinete y del caballo.</li><li>Herramientas para desarrollar un asiento más consciente, equilibrado, sensible y eficaz.</li><li>Conocimientos de etología y formas de aprendizaje para comprender cómo aprende el caballo y cómo comunicarte mejor con él.</li><li>Criterios para iniciar, entrenar, formar y reeducar caballos de manera progresiva, metodológica y respetuosa.</li><li>Capacidad para observar, evaluar y diseñar un plan de trabajo adecuado para cada caballo.</li><li>Una mirada profesional basada en el bienestar equino, la ética y el respeto por su naturaleza.</li><li>Mayor autonomía y criterio propio para tomar decisiones y resolver situaciones reales.</li><li>Una metodología que te permitirá ordenar e integrar todo lo aprendido, en lugar de acumular conocimientos aislados.</li></ul>","_css_classes":""},"elements":[]},{"id":"1030557","elType":"widget","widgetType":"text-editor","settings":{"editor":"<p class='bta-note'>Al finalizar esta Formación no solo habrás incorporado conocimientos: habrás construido una base ecuestre sólida desde la cual seguir creciendo, especializarte y desarrollar tu propio camino.</p>","_css_classes":""},"elements":[]}]}]},{"id":"103fccf","elType":"container","isInner":false,"settings":{"flex_direction":"column","content_width":"full","css_classes":"bta-section","background_background":"classic","background_color":"#F1E6D2","padding":{"unit":"px","top":"88","right":"24","bottom":"88","left":"24","isLinked